DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deepguard
DB_ECHO=0

SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

MODEL_PATH=
MODEL_VERSION=b4-baseline-v1
MODEL_THRESHOLD=0.35
MOCK_ML=true

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Phase 2: S3 artifact (heatmap evidence) — để trống là tắt ──
S3_BUCKET=
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Phase 2: CloudWatch log forwarder (scripts/push_to_cloudwatch.py) ──
CW_LOG_GROUP=/deepguard/backend
CW_LOG_STREAM=
CW_REGION=ap-southeast-1
