# serving/serving.env — env tuỳ chọn cho 2 inference server.
# File thật (serving.env) KHÔNG commit; copy từ .example này hoặc để redeploy.sh tự tạo.
#
# systemd nhận file này bằng cách thêm vào [Service] của deepguard-sfdct / deepguard-liveness:
#   EnvironmentFile=-/home/ubuntu/deepguard/app/serving/serving.env
# Chạy tay: set -a; . serving/serving.env; set +a; uvicorn serving.infer_server:app ...

SFDCT_VERSION=naive-sfdct-cdfv2-0.7572
LIVENESS_VERSION=b4-liveness-auc0.9829
# SFDCT_THRESHOLD=0.5
# SFDCT_CKPT=/duong/dan/khac/ckpt.pth      # mặc định: serving/naive_sfdct/ckpt_best.pth
# LIVENESS_CKPT=/duong/dan/khac/ckpt.pth   # mặc định: serving/liveness_b4/ckpt_best.pth
