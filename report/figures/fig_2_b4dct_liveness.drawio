<mxfile host="app.diagrams.net" type="device">
  <diagram id="sfdct-lean" name="SFDCT lean architecture">
    <mxGraphModel dx="1200" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== nodes ===== -->
        <mxCell id="face" value="face&#10;crop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=20;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="EfficientNet-B4&#10;spatial &#8594; F_s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=20;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="dct" value="block-DCT&#10;frequency &#8594; D" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=20;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="fuse" value="gated fusion&#10;(alpha init 0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=20;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="940" y="300" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="head" value="head &#8594;&#10;verdict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=20;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1300" y="300" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- ===== edges (straight, lean) ===== -->
        <mxCell id="e_face_b4" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#000000;strokeWidth=2.5;endSize=10;" edge="1" parent="1" source="face" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_face_dct" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#000000;strokeWidth=2.5;endSize=10;" edge="1" parent="1" source="face" target="dct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_b4_fuse" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#000000;strokeWidth=2.5;endSize=10;" edge="1" parent="1" source="b4" target="fuse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dct_fuse" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#000000;strokeWidth=2.5;endSize=10;" edge="1" parent="1" source="dct" target="fuse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fuse_head" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;startArrow=none;strokeColor=#000000;strokeWidth=2.5;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fuse" target="head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
